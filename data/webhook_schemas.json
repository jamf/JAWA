    "PatchSoftwareTitleUpdated": {
      "description": "Triggered when a patch software title definition is updated",
      "schema": {
        "jssID": "<integer> Jamf Pro patch software title ID",
        "lastUpdate": "<integer> Epoch timestamp of last update",
        "latestVersion": "<string> Latest available version",
        "name": "<string> Software title name",
        "reportUrl": "<string> URL to the patch report in Jamf Pro"
      }
    },
    "PushSent": {
      "description": "Triggered when a push notification is sent (generic)",
      "schema": {
        "type": "<string> Type of push notification sent",
        "jssID": "<integer> ID of the device or object receiving the push"
      }
    },
    "RestAPIOperation": {
      "description": "Triggered when a REST API operation is performed",
      "schema": {
        "authorizedUsername": "<string> Username that authenticated the request",
        "objectID": "<integer> ID of the object that was operated on",
        "objectName": "<string> Name of the object",
        "objectTypeName": "<string> Type of object (e.g., Computer, Policy)",
        "operationSuccessful": "<boolean> Whether the operation succeeded",
        "restAPIOperationType": "<string> Type of operation (GET, POST, PUT, DELETE)"
      }
    },
    "SCEPChallenge": {
      "description": "Triggered when a SCEP challenge is requested",
      "schema": {
        "challenge": "<string> The SCEP challenge password",
        "deviceName": "<string> Name of the device requesting SCEP",
        "jssID": "<integer> Jamf Pro device ID",
        "product": "<string> Device product type",
        "serialNumber": "<string> Device serial number",
        "udid": "<string> Device UDID"
      }
    },
    "SmartGroupComputerMembershipChange": {
      "description": "Triggered when a computer's smart group membership changes",
      "schema": {
        "computer": "<boolean> Indicates this is a computer group",
        "groupAddedDevices": "<array> List of device IDs added to the group",
        "groupAddedDevicesIds": "<array> List of Jamf Pro IDs for added devices",
        "groupRemovedDevices": "<array> List of device IDs removed from the group",
        "groupRemovedDevicesIds": "<array> List of Jamf Pro IDs for removed devices",
        "jssID": "<integer> Smart group ID",
        "name": "<string> Smart group name",
        "smartGroup": "<boolean> Indicates this is a smart group"
      }
    },
    "SmartGroupMobileDeviceMembershipChange": {
      "description": "Triggered when a mobile device's smart group membership changes",
      "schema": {
        "computer": "<boolean> Indicates this is a computer group (false for mobile)",
        "groupAddedDevices": "<array> List of device IDs added to the group",
        "groupAddedDevicesIds": "<array> List of Jamf Pro IDs for added devices",
        "groupRemovedDevices": "<array> List of device IDs removed from the group",
        "groupRemovedDevicesIds": "<array> List of Jamf Pro IDs for removed devices",
        "jssID": "<integer> Smart group ID",
        "name": "<string> Smart group name",
        "smartGroup": "<boolean> Indicates this is a smart group"
      }
    },
    "SmartGroupUserMembershipChange": {
      "description": "Triggered when a user's smart group membership changes",
      "schema": {
        "groupAddedUserIds": "<array> List of user IDs added to the group",
        "groupAddedUsers": "<array> List of usernames added to the group",
        "groupRemovedUserIds": "<array> List of user IDs removed from the group",
        "groupRemovedUsers": "<array> List of usernames removed from the group",
        "jssID": "<integer> Smart group ID",
        "name": "<string> Smart group name",
        "smartGroup": "<boolean> Indicates this is a smart group"
      }
    }
  },
