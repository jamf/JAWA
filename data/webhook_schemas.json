    "JSSShutdown": {
      "description": "Triggered when the Jamf Pro server shuts down",
      "schema": {
        "hostAddress": "<string> IP address or hostname of the Jamf Pro server",
        "institution": "<string> Organization name configured in Jamf Pro",
        "isClusterMaster": "<boolean> Whether this node is the cluster master",
        "jssUrl": "<string> Full URL of the Jamf Pro server",
        "webApplicationPath": "<string> File system path to the web application"
      }
    },
    "JSSStartup": {
      "description": "Triggered when the Jamf Pro server starts up",
