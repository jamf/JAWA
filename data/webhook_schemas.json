    "DeviceAddedToDEP": {
      "description": "Triggered when a device is added to Apple Business/School Manager (DEP)",
      "schema": {
        "assetTag": "<string> Asset tag assigned to the device",
        "description": "<string> Device description from Apple",
        "deviceAssignedDate": "<integer> Epoch timestamp when device was assigned",
        "deviceEnrollmentProgramInstanceId": "<integer> DEP instance ID in Jamf Pro",
        "model": "<string> Device model",
        "serialNumber": "<string> Device serial number"
      }
    },
    "DeviceRateLimited": {
      "description": "Triggered when Jamf Pro rate limits communication with a device. Field schema and sample payload are pending confirmation against a live Jamf Pro instance.",
