    {
        "slug": "tap-return-to-service",
        "title": "Return to Service (Tap Action)",
        "description": "Let the person holding a shared iPad or iPhone reset it themselves: a web clip erases the device and re-enrolls it onto your Wi-Fi with no IT touch.",
        "category": "provisioning",
        "trigger_type": "tap",
        "trigger_event": null,
        "script_file": "tap_return_to_service.py",
        "hook_name": "return-to-service",
        "tap": {
            "device_family": "mobile",
            "page_title": "Reset {DEVICENAME}?",
            "page_description": "This device will erase everything on it and set itself up again automatically. Make sure nothing on it still needs saving.",
            "confirm_label": "Erase and reset this device",
            "success_message": "This device will erase in a moment and set itself up again. You can put it down.",
            "failure_message": "This device could not be reset. Please tell IT."
        },
        "api_privileges": [
            "Read Mobile Devices",
            "Read Mobile Device Configuration Profiles",
            "Send Mobile Device Erase Device Command"
        ],
        "config_params": [
            {
                "key": "server_url",
                "label": "Jamf Pro URL",
                "placeholder": "https://example.jamfcloud.com",
                "token": "\"__JAWA_SERVER_URL__\"",
                "type": "text"
            },
            {
                "key": "client_id",
                "label": "OAuth Client ID",
                "placeholder": "your-api-client-id",
                "token": "\"__JAWA_CLIENT_ID__\"",
                "type": "text"
            },
            {
                "key": "client_secret",
                "label": "OAuth Client Secret",
                "placeholder": "your-api-client-secret",
                "token": "\"__JAWA_CLIENT_SECRET__\"",
                "type": "password"
            },
            {
                "key": "wifi_profile_name",
                "label": "Wi-Fi configuration profile name (existing, in Jamf Pro)",
                "placeholder": "Managed WiFi",
                "token": "\"__JAWA_WIFI_PROFILE_NAME__\"",
                "type": "text"
            }
        ],
        "exit_codes": [
            {"code": 0, "meaning": "Success — erase with Return to Service sent"},
            {"code": 12, "meaning": "Payload did not name a device id and UDID"},
            {"code": 20, "meaning": "UDID did not match the device record (refused)"},
            {"code": 21, "meaning": "Device id not found in Jamf Pro"},
            {"code": 22, "meaning": "Device has no managementId"},
            {"code": 23, "meaning": "Erase command refused by Jamf Pro"},
            {"code": 24, "meaning": "Wi-Fi configuration profile not found in Jamf Pro"},
            {"code": 25, "meaning": "Named profile carries no Wi-Fi payload"}
        ],
        "tags": ["tap-action", "web-clip", "mobile", "erase", "return-to-service"],
