    {
        "slug": "tap-brander",
        "title": "Brander (Tap Action)",
        "description": "Let the person holding an iPad or iPhone apply a branded wallpaper showing the device's name, serial, location and a QR code of its Jamf Pro id.",
        "category": "provisioning",
        "trigger_type": "tap",
        "trigger_event": null,
        "script_file": "tap_brander.py",
        "hook_name": "brand-device",
        "tap": {
            "device_family": "mobile",
            "page_title": "Brand {DEVICENAME}",
            "page_description": "Apply the standard wallpaper with this device's identifying details.",
            "confirm_label": "Apply wallpaper",
            "success_message": "The wallpaper is on its way. It can take a minute to appear.",
            "failure_message": "The wallpaper could not be applied. Please tell IT.",
            "cooldown_minutes": 5
        },
        "api_privileges": [
            "Read Mobile Devices",
            "Send Mobile Device Set Wallpaper Command"
        ],
        "config_params": [
            {
                "key": "server_url",
                "label": "Jamf Pro URL",
                "placeholder": "https://example.jamfcloud.com",
                "token": "\"__JAWA_SERVER_URL__\"",
                "type": "text"
            },
            {
                "key": "client_id",
                "label": "OAuth Client ID",
                "placeholder": "your-api-client-id",
                "token": "\"__JAWA_CLIENT_ID__\"",
                "type": "text"
            },
            {
                "key": "client_secret",
                "label": "OAuth Client Secret",
                "placeholder": "your-api-client-secret",
                "token": "\"__JAWA_CLIENT_SECRET__\"",
                "type": "password"
            },
            {
                "key": "ea_id",
                "label": "Jamf Setup role extension attribute ID (0 if unused)",
                "placeholder": "0",
                "token": "__JAWA_EA_ID__",
                "type": "number"
            },
            {
                "key": "wallpaper_setting",
                "label": "Wallpaper target (1 lock screen, 2 home screen, 3 both)",
                "placeholder": "3",
                "token": "__JAWA_WALLPAPER_SETTING__",
                "type": "number"
            },
            {
                "key": "assets_dir",
                "label": "Assets directory (backgrounds)",
                "placeholder": "/usr/local/jawa/data/workflows/assets/brander",
                "token": "\"__JAWA_ASSETS_DIR__\"",
                "type": "text"
            },
            {
                "key": "font_path",
                "label": "Font file path (enter none for the built-in font)",
                "placeholder": "none",
                "token": "\"__JAWA_FONT_PATH__\"",
                "type": "text"
            },
            {
                "key": "template_path",
                "label": "Wallpaper template (JSON file, absolute or in the assets directory; legacy for the original layout)",
                "placeholder": "legacy",
                "default": "legacy",
                "suggest": "brander_templates",
                "token": "\"__JAWA_TEMPLATE_PATH__\"",
                "type": "text"
            },
            {
                "key": "allow_person_fields",
                "label": "Allow personal fields (yes or no): lets a template that asks for them print the user's name, username and email",
                "placeholder": "no",
                "default": "no",
                "token": "\"__JAWA_ALLOW_PERSON_FIELDS__\"",
                "type": "text"
            },
            {
                "key": "max_kb",
                "label": "Largest wallpaper to send, in KB (larger images are sent as JPEG)",
                "placeholder": "1500",
                "default": "1500",
                "token": "__JAWA_MAX_KB__",
                "type": "number"
            }
        ],
        "exit_codes": [
            {"code": 0, "meaning": "Success — wallpaper command sent"},
            {"code": 12, "meaning": "Payload did not name a device id and UDID"},
            {"code": 20, "meaning": "UDID did not match the device record (refused)"},
            {"code": 21, "meaning": "Device id not found in Jamf Pro"},
            {"code": 22, "meaning": "Jamf Pro refused the device lookup"},
            {"code": 24, "meaning": "Wallpaper command refused by Jamf Pro"},
            {"code": 25, "meaning": "Device is not supervised (wallpapers need supervision)"},
            {"code": 26, "meaning": "Device is not iOS or iPadOS"},
            {"code": 30, "meaning": "Wallpaper template missing, unreadable or invalid"},
            {"code": 31, "meaning": "Template renderer missing, edited, or on an unsupported Pillow"},
            {"code": 32, "meaning": "Wallpaper template failed to render"},
            {"code": 33, "meaning": "Wallpaper template took too long to render"},
            {"code": 34, "meaning": "Wallpaper is over the size budget even as JPEG"},
            {"code": 42, "meaning": "The device's Brander extension attribute is Off"}
        ],
        "tags": ["tap-action", "web-clip", "mobile", "wallpaper", "branding"],
        "order": 10
    },
    {
        "slug": "asset-tag-brander",
        "title": "Brander (Asset Tag Watch)",
        "description": "Watch every mobile device on a schedule and re-brand one with the Brander when its asset tag or Brander extension attribute changes, so the wallpaper never shows an old tag.",
        "category": "provisioning",
        "trigger_type": "cron",
        "trigger_event": null,
        "default_schedule": "*/15 * * * *",
        "script_file": "asset_tag_brander.py",
        "hook_name": "asset-tag-brander",
        "api_privileges": [
            "Read Mobile Devices"
        ],
        "config_params": [
            {
                "key": "server_url",
                "label": "Jamf Pro URL",
                "placeholder": "https://example.jamfcloud.com",
                "token": "\"__JAWA_SERVER_URL__\"",
                "type": "text"
            },
            {
                "key": "client_id",
                "label": "OAuth Client ID",
                "placeholder": "your-api-client-id",
                "token": "\"__JAWA_CLIENT_ID__\"",
                "type": "text"
            },
            {
                "key": "client_secret",
                "label": "OAuth Client Secret",
                "placeholder": "your-api-client-secret",
                "token": "\"__JAWA_CLIENT_SECRET__\"",
                "type": "password"
            },
            {
                "key": "brander_script",
                "label": "Brander script path (the installed Brander (Tap Action) automation's script)",
                "placeholder": "/usr/local/jawa/scripts/brand-device.py",
                "default": "/usr/local/jawa/scripts/brand-device.py",
                "token": "\"__JAWA_BRANDER_SCRIPT__\"",
                "type": "text"
            },
            {
                "key": "db_path",
                "label": "State database (SQLite file)",
                "placeholder": "/usr/local/jawa/data/asset_tag_watch.sqlite",
                "default": "/usr/local/jawa/data/asset_tag_watch.sqlite",
                "token": "\"__JAWA_DB_PATH__\"",
                "type": "text"
            },
            {
                "key": "dry_run",
                "label": "Dry run (yes or no): yes only reports which devices would be branded",
                "placeholder": "no",
                "default": "no",
                "token": "\"__JAWA_DRY_RUN__\"",
                "type": "text"
            }
        ],
        "exit_codes": [
            {"code": 0, "meaning": "Success — every change was branded or settled"},
            {"code": 1, "meaning": "Could not list mobile devices (nothing stored)"},
            {"code": 2, "meaning": "At least one brand attempt failed; it is retried on the next run"}
        ],
        "tags": ["cron", "mobile", "wallpaper", "branding", "asset-tag"],
        "order": 11
    }
